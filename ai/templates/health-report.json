{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Health Report Schema",
  "description": "Structured output format for /health command results.",
  "type": "object",
  "required": ["date", "dimensions", "overallHealth"],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "details"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["stack", "typeSafety", "testing", "linting", "build", "security", "architecture"]
          },
          "status": {
            "type": "string",
            "enum": ["healthy", "warning", "critical"]
          },
          "details": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "check": { "type": "string" },
                "passed": { "type": "boolean" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "overallHealth": {
      "type": "string",
      "enum": ["healthy", "degraded", "critical"]
    },
    "criticalIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "action": { "type": "string" },
          "effort": { "type": "string", "enum": ["small", "medium", "large"] },
          "impact": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "technicalDebt": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "effort": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    }
  }
}
