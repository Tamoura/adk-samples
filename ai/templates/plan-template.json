{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Engineering Plan",
  "description": "Machine-verifiable implementation plan schema. All plans generated by /plan must conform to this structure.",
  "type": "object",
  "required": ["name", "summary", "files", "steps", "testStrategy", "risks", "rollback"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Short descriptive name for the feature/change"
    },
    "summary": {
      "type": "string",
      "description": "1-2 sentence description of what will be built"
    },
    "files": {
      "type": "array",
      "description": "All files that will be created, modified, or deleted",
      "items": {
        "type": "object",
        "required": ["path", "action", "description"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative file path from repo root"
          },
          "action": {
            "type": "string",
            "enum": ["create", "modify", "delete"],
            "description": "What operation will be performed"
          },
          "description": {
            "type": "string",
            "description": "What changes will be made to this file"
          }
        }
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "description": "Ordered implementation steps",
      "items": {
        "type": "object",
        "required": ["order", "description", "verification"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "description": "What this step accomplishes"
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Files touched in this step"
          },
          "verification": {
            "type": "string",
            "description": "How to verify this step succeeded"
          }
        }
      },
      "minItems": 1
    },
    "testStrategy": {
      "type": "object",
      "required": ["tests"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "description"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Test function/case name"
              },
              "type": {
                "type": "string",
                "enum": ["unit", "integration", "e2e"],
                "description": "Test category"
              },
              "description": {
                "type": "string",
                "description": "What this test verifies"
              }
            }
          }
        },
        "coverageTarget": {
          "type": "string",
          "description": "Target coverage for new code"
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "Known risks and mitigations",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "mitigation"],
        "properties": {
          "risk": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "description": "How to undo these changes"
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific rollback steps"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "New packages or services required",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "diffEstimate": {
      "type": "object",
      "properties": {
        "filesChanged": { "type": "integer" },
        "linesAdded": { "type": "integer" },
        "linesRemoved": { "type": "integer" }
      }
    }
  }
}
